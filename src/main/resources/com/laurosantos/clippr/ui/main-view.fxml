<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laurosantos.clippr.ui.MainController"
            prefWidth="1100.0" prefHeight="750.0">

    <padding>
        <Insets top="14.0" right="18.0" bottom="14.0" left="18.0" />
    </padding>

    <!-- Top Header -->
    <top>
        <VBox spacing="8.0">
            <HBox alignment="CENTER_LEFT" spacing="14.0">
                <Label text="✂ Clippr" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
                <Label text="AI &amp; FFmpeg Video Clipper (Java 25)" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 13px;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="dbStatusBadge" text="● PostgreSQL: Conectando..." style="-fx-font-size: 12px; -fx-text-fill: -color-warning-fg;" />
                <Label fx:id="ffmpegStatusBadge" text="● FFmpeg: OK" style="-fx-font-size: 12px; -fx-text-fill: -color-success-fg;" />
            </HBox>
            <Separator />
        </VBox>
    </top>

    <!-- Center Tabs -->
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <BorderPane.margin>
                <Insets top="10.0" bottom="10.0" />
            </BorderPane.margin>

            <!-- TAB 1: FILA DE VÍDEOS -->
            <Tab text="📺 Fila de Vídeos">
                <VBox spacing="12.0">
                    <padding>
                        <Insets top="12.0" right="8.0" bottom="8.0" left="8.0" />
                    </padding>

                    <!-- Adicionar Link -->
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <TextField fx:id="linkInputField" promptText="Cole o link do YouTube aqui (ex: https://www.youtube.com/watch?v=...)"
                                   HBox.hgrow="ALWAYS" onAction="#onAddLink" />
                        <Button text="+ Adicionar à Fila" onAction="#onAddLink" styleClass="accent" />
                    </HBox>

                    <!-- Tabela de Vídeos na Fila -->
                    <TableView fx:id="videoTableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colVideoTitle" text="Título / URL" prefWidth="420.0" />
                            <TableColumn fx:id="colVideoAuthor" text="Canal" prefWidth="180.0" />
                            <TableColumn fx:id="colVideoDuration" text="Duração" prefWidth="100.0" />
                            <TableColumn fx:id="colVideoStatus" text="Status" prefWidth="220.0" />
                        </columns>
                        <placeholder>
                            <Label text="Nenhum link adicionado. Cole um link do YouTube acima e clique em 'Adicionar à Fila'." />
                        </placeholder>
                    </TableView>

                    <!-- Barra de Configurações Rápidas -->
                    <HBox spacing="16.0" alignment="CENTER_LEFT" style="-fx-background-color: -color-bg-subtle; -fx-padding: 10px; -fx-background-radius: 6px;">
                        <CheckBox fx:id="chkSubtitles" text="Legendas Dinâmicas (.ass)" selected="true" />
                        <CheckBox fx:id="chkAutoProcess" text="Processar Automaticamente (Score &gt;= 90)" />
                        <Separator orientation="VERTICAL" />
                        <Label text="Orientação:" />
                        <ComboBox fx:id="comboOrientation" prefWidth="200.0" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="🗑 Limpar Fila" onAction="#onClearQueue" />
                        <Button fx:id="btnStartPipeline" text="▶ Iniciar Processamento" onAction="#onStartPipeline" styleClass="success" />
                    </HBox>
                </VBox>
            </Tab>

            <!-- TAB 2: CORTES DETECTADOS & PLAYER -->
            <Tab text="🎬 Cortes &amp; Momentos Virais">
                <SplitPane dividerPositions="0.55" VBox.vgrow="ALWAYS">
                    <!-- Painel Esquerdo: Tabela de Cortes -->
                    <VBox spacing="10.0">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                        </padding>

                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="Momentos Virais Detectados:" style="-fx-font-weight: bold;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button text="▶ Renderizar Selecionado" onAction="#onRenderSelectedClip" styleClass="accent" />
                            <Button text="⚡ Renderizar Todos (100% CPU)" onAction="#onRenderAllApproved" styleClass="success" />
                        </HBox>

                        <TableView fx:id="clipTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colClipScore" text="Score" prefWidth="75.0" />
                                <TableColumn fx:id="colClipTitle" text="Título do Corte" prefWidth="200.0" />
                                <TableColumn fx:id="colClipHook" text="Gancho (3s)" prefWidth="180.0" />
                                <TableColumn fx:id="colClipTime" text="Intervalo" prefWidth="110.0" />
                                <TableColumn fx:id="colClipOrientation" text="Formato" prefWidth="80.0" />
                                <TableColumn fx:id="colClipStatus" text="Status" prefWidth="110.0" />
                            </columns>
                            <placeholder>
                                <Label text="Nenhum corte gerado ainda. Processe um vídeo na aba 'Fila de Vídeos'." />
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- Painel Direito: Player de Vídeo e Ajuste Fino -->
                    <VBox spacing="10.0">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                        </padding>

                        <Label text="Pré-visualização do Corte:" style="-fx-font-weight: bold;" />

                        <!-- Container do Vídeo com proporção preservada -->
                        <StackPane fx:id="playerContainer" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: #0d1117; -fx-background-radius: 8px;">
                            <MediaView fx:id="mediaView" preserveRatio="true" />
                            <Label fx:id="playerPlaceholderLabel" text="Selecione um corte na tabela para assistir"
                                   style="-fx-text-fill: -color-fg-muted;" />
                        </StackPane>

                        <!-- Controles de Reprodução -->
                        <VBox spacing="6.0" style="-fx-background-color: -color-bg-subtle; -fx-padding: 8px; -fx-background-radius: 6px;">
                            <Slider fx:id="timeSlider" max="100.0" value="0.0" />
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Button fx:id="btnPlayPause" text="▶ Play" onAction="#onTogglePlayPause" />
                                <Label fx:id="timeLabel" text="00:00 / 00:00" style="-fx-font-family: monospace;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="🔊" />
                                <Slider fx:id="volumeSlider" prefWidth="80.0" max="1.0" value="0.8" />
                            </HBox>
                        </VBox>

                        <!-- Painel de Ajuste Fino de Timestamps -->
                        <VBox spacing="6.0" style="-fx-background-color: -color-bg-subtle; -fx-padding: 10px; -fx-background-radius: 6px;">
                            <Label text="Ajuste Fino dos Marcadores de Tempo:" style="-fx-font-weight: bold; -fx-font-size: 11px;" />
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <Label text="Início:" prefWidth="45.0" />
                                <Label fx:id="lblStartSeconds" text="0.0s" style="-fx-font-weight: bold;" prefWidth="55.0" />
                                <Button text="-1s" onAction="#onAdjustStartMinus1" />
                                <Button text="+1s" onAction="#onAdjustStartPlus1" />
                                <Button text="📍 Definir Início Aqui" onAction="#onSetStartCurrent" styleClass="accent" />
                            </HBox>
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <Label text="Fim:" prefWidth="45.0" />
                                <Label fx:id="lblEndSeconds" text="0.0s" style="-fx-font-weight: bold;" prefWidth="55.0" />
                                <Button text="-1s" onAction="#onAdjustEndMinus1" />
                                <Button text="+1s" onAction="#onAdjustEndPlus1" />
                                <Button text="📍 Definir Fim Aqui" onAction="#onSetEndCurrent" styleClass="accent" />
                            </HBox>
                        </VBox>
                    </VBox>
                </SplitPane>
            </Tab>

            <!-- TAB 3: CONFIGURAÇÕES & DIAGNÓSTICO -->
            <Tab text="⚙ Configurações &amp; Ambiente">
                <VBox spacing="16.0">
                    <padding>
                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
                    </padding>

                    <VBox spacing="8.0">
                        <Label text="Chave de API do Google Gemini:" style="-fx-font-weight: bold;" />
                        <HBox spacing="10.0">
                            <PasswordField fx:id="geminiApiKeyField" promptText="Cole sua chave GEMINI_API_KEY aqui" HBox.hgrow="ALWAYS" />
                            <Button text="Salvar Chave" onAction="#onSaveApiKey" styleClass="accent" />
                        </HBox>
                        <Label text="A chave pode ser configurada aqui ou via variável de ambiente GEMINI_API_KEY." style="-fx-text-fill: -color-fg-muted; -fx-font-size: 11px;" />
                    </VBox>

                    <VBox spacing="8.0">
                        <Label text="Pasta de Exportação dos Vídeos:" style="-fx-font-weight: bold;" />
                        <HBox spacing="10.0">
                            <TextField fx:id="outputDirField" HBox.hgrow="ALWAYS" />
                            <Button text="Escolher Pasta..." onAction="#onBrowseOutputDir" />
                        </HBox>
                    </VBox>

                    <Separator />

                    <VBox spacing="10.0">
                        <Label text="Diagnóstico de Componentes do Sistema:" style="-fx-font-weight: bold;" />
                        <GridPane hgap="14.0" vgap="8.0">
                            <Label text="PostgreSQL (Docker):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label fx:id="diagPostgresLabel" text="Verificando..." GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Button text="Subir Docker Compose" onAction="#onStartDockerCompose" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                            <Label text="FFmpeg:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="diagFfmpegLabel" text="Verificando..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="yt-dlp:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Label fx:id="diagYtDlpLabel" text="Verificando..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        </GridPane>
                    </VBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <!-- Bottom Section: Logs & Progress -->
    <bottom>
        <VBox spacing="8.0">
            <Separator />

            <!-- Barras de Progresso e Status -->
            <HBox spacing="14.0" alignment="CENTER_LEFT">
                <Label fx:id="statusLabel" text="Pronto para processar vídeos" HBox.hgrow="ALWAYS"
                       style="-fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Progresso:" style="-fx-text-fill: -color-fg-muted;" />
                <ProgressBar fx:id="progressBar" prefWidth="260.0" progress="0.0" />
            </HBox>

            <!-- Console de Logs com Toggle Amigável / Debug -->
            <VBox spacing="4.0">
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label text="Console de Execução:" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <CheckBox fx:id="chkDebugMode" text="Modo Detalhado (Debug FFmpeg/yt-dlp)" />
                    <Button text="Limpar Console" onAction="#onClearLogs" style="-fx-font-size: 11px;" />
                </HBox>
                <TextArea fx:id="logArea" prefHeight="130.0" editable="false" wrapText="true"
                          style="-fx-font-family: monospace; -fx-font-size: 12px;" />
            </VBox>
        </VBox>
    </bottom>
</BorderPane>
